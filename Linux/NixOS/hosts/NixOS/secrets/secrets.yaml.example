# Template for SYSTEM-LEVEL secrets (decrypted into /run/secrets/*).
# Create the real file with:
#   sops hosts/NixOS/secrets/secrets.yaml
#
# Keys here must match `sops.secrets.<name>` entries in sops.nix.
# Values are plain strings before encryption; sops wraps them with `ENC[...]` on save.
#
# For USER-LEVEL secrets (decrypted into $HOME/.ssh, $HOME/.netrc) see
# home/secrets/secrets.yaml.example - that one uses a separate user age key and a different scope.

example: "replace-me"
# openai_api_key: "sk-..."
# wireguard:
#   private_key: "..."
