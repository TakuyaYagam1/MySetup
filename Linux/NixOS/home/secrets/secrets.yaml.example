# Template for USER-LEVEL secrets (HM-level, decrypted into $HOME).
# Create the real file via:
#   sops home/secrets/secrets.yaml
#
# .sops.yaml is looked up upward; hosts/NixOS/secrets/.sops.yaml is used -
# add your user public age key there as &user_main.
# Encryption is driven by the rule: `path_regex: home/secrets/.*\.yaml$`.
#
# For SYSTEM-LEVEL secrets (decrypted into /run/secrets) see
# hosts/NixOS/secrets/secrets.yaml.example - that one uses a separate host age key.

example: "replace-me"

# ssh-config: |
#   Host github.com
#     User git
#     IdentityFile ~/.ssh/github
#   Host gitlab.com
#     User git
#     IdentityFile ~/.ssh/gitlab
#
# netrc: "machine api.github.com login user password ghp_xxx"
#
# github-key: |
#   -----BEGIN OPENSSH PRIVATE KEY-----
#   ...
#   -----END OPENSSH PRIVATE KEY-----
