# whkd config - komorebi navigation + app launchers.
# Mapping: Super -> Alt (per user request).
# Source for launchers: Linux/dots/hypr/shell-common-keybinds.conf + variables.conf
# whkd docs: https://github.com/LGUG2Z/whkd
# komorebi docs: https://github.com/LGUG2Z/komorebi

.shell cmd

# ==================================
# komorebi - window manager controls
# ==================================

# Close focused window
alt + q : komorebic close

# Focus windows
alt + h : komorebic focus left
alt + j : komorebic focus down
alt + k : komorebic focus up
alt + l : komorebic focus right

# Move windows
alt + shift + h : komorebic move left
alt + shift + j : komorebic move down
alt + shift + k : komorebic move up
alt + shift + l : komorebic move right

# Cycle windows in container
alt + oem_4 : komorebic cycle-focus previous  # alt + [
alt + oem_6 : komorebic cycle-focus next      # alt + ]

# Focus workspace 1..7  (komorebi.json: I..VII)
alt + 1 : komorebic focus-workspace 0
alt + 2 : komorebic focus-workspace 1
alt + 3 : komorebic focus-workspace 2
alt + 4 : komorebic focus-workspace 3
alt + 5 : komorebic focus-workspace 4
alt + 6 : komorebic focus-workspace 5
alt + 7 : komorebic focus-workspace 6

# Move active window to workspace 1..7
alt + shift + 1 : komorebic move-to-workspace 0
alt + shift + 2 : komorebic move-to-workspace 1
alt + shift + 3 : komorebic move-to-workspace 2
alt + shift + 4 : komorebic move-to-workspace 3
alt + shift + 5 : komorebic move-to-workspace 4
alt + shift + 6 : komorebic move-to-workspace 5
alt + shift + 7 : komorebic move-to-workspace 6

# Manipulate windows
alt + space : komorebic toggle-float
alt + shift + space : komorebic toggle-monocle
alt + p : komorebic toggle-pause
alt + shift + r : komorebic retile
alt + shift + return : komorebic promote

# Resize
alt + oem_minus : komorebic resize-axis horizontal decrease  # alt + -
alt + oem_plus : komorebic resize-axis horizontal increase  # alt + =
alt + shift + oem_minus : komorebic resize-axis vertical decrease
alt + shift + oem_plus : komorebic resize-axis vertical increase

# Layouts
alt + x : komorebic flip-layout horizontal
alt + y : komorebic flip-layout vertical

# ===============================================================
# App launchers (ported from Linux Hyprland config, Super -> Alt)
# ===============================================================

# Terminal: Termius  (Linux: $kbTerminal = Super, Return -> foot)
alt + return : powershell -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "%USERPROFILE%\.config\launch.ps1" Termius

