# keep private IDA modules and local installer files outside the public repo
#
# Setup after nixos-rebuild switch:
#   1. copy 4 files in /etc/nixos/private: 3 idas and 1 gen
#   2. nix-store --add-fixed sha256 ~/MySetup/Linux/NixOS/packages/ida/ida-pro_94_x64linux.run
#   2.1 nix hash file ~/MySetup/Linux/NixOS/packages/ida/ida-pro_94_x64linux.run
#   2.2 update hash in ida-pro.nix
#   3. nixos-update

Linux/NixOS/packages/ida/
Linux/NixOS/packages/ida-pro.nix
Linux/NixOS/packages/ida-mcp.nix
Linux/NixOS/packages/ida-plugins.nix
.codex
.cursor/
__pycache__/
*.py[cod]
result
result-*
**/result
**/result-*
*.mp4
*.mkv
*.webm
